#!/usr/bin/env bash
# riceforge: whole-desktop themes and maintenance for the Riceforge Hyprland desktop.
#
#   riceforge list                   themes available
#   riceforge status                 active theme and link health
#   riceforge verify [theme]         validate a theme without applying it
#   riceforge apply <theme>          verify, switch, live-reload, run session hooks
#   riceforge revert                 apply "original"
#   riceforge preview-bar <theme>    show that theme's waybar for 8s (no focus grab)
#   riceforge session-start          start the active theme's session (login autostart)
#   riceforge doctor                 check packages, links, configs, services, processes
#   riceforge update                 git pull --ff-only, redeploy, check
#   riceforge backups                list install backups
#   riceforge restore <stamp>        put the files from one backup back
#   riceforge uninstall [--dry-run]  remove Riceforge's links, restore backups
#   riceforge render                 re-render theme templates (*.in)
#
# Each themed file in ~/.config is a symlink into ~/.config/riceforge/current,
# which points at themes/<name>. A theme may ship an executable `session`
# (start|stop) that owns its long-running helpers. Machine-specific settings
# live in ~/.config/riceforge-local, never in the repo.
set -euo pipefail

RF_SRC="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd -P)"
export RF_SRC
# shellcheck source=../install/lib.sh
. "$RF_SRC/install/lib.sh"
CFG="$HOME/.config"
THEMES="$RF_SRC/themes"
CURRENT="$RF_SRC/current"
LIVE=0; [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && LIVE=1
[[ "${RICEFORGE_NO_LIVE:-0}" == 1 ]] && LIVE=0

theme_dir() { [[ -d "$THEMES/$1" ]] || die "no theme '$1' (try: riceforge list)"; echo "$THEMES/$1"; }
active()    { [[ -L "$CURRENT" ]] && basename "$(readlink "$CURRENT")" || echo "none"; }
has_session() { [[ -x "$THEMES/$1/session" ]]; }
run_session() {  # $1 theme, $2 start|stop
    has_session "$1" || return 0
    "$THEMES/$1/session" "$2" && note "$1 session: $2"
}

verify_hypr() {  # $1 = lua file
    have Hyprland || { note "Hyprland not installed; config check skipped"; return 0; }
    local out
    if [[ -z "${XDG_RUNTIME_DIR:-}" ]]; then        # su/sudo shells have none; Hyprland insists
        export XDG_RUNTIME_DIR; XDG_RUNTIME_DIR=$(mktemp -d); chmod 700 "$XDG_RUNTIME_DIR"
    fi
    out=$(Hyprland --verify-config -c "$1" 2>&1 | sed -n '/Config parsing result/,$p' | tail -n +3 || true)
    [[ "$out" == "config ok" ]] || { echo "$out" >&2; return 1; }
}

verify_css() {  # $1 = gtk version, $2 = file
    python3 -I - "$1" "$2" <<'PY'
import sys, gi
ver, path = sys.argv[1], sys.argv[2]
try:
    gi.require_version('Gtk', ver)
    from gi.repository import Gtk
except (ValueError, ImportError) as e:
    print(f"(skipped: GTK {ver} bindings unavailable: {e})"); sys.exit(0)
errs = []
p = Gtk.CssProvider()
p.connect('parsing-error', lambda _p, sec, err: errs.append(f"{sec.to_string()}: {err.message}"))
data = open(path).read()
p.load_from_string(data) if ver == '4.0' else p.load_from_data(data.encode())
if errs:
    print("\n".join(errs), file=sys.stderr); sys.exit(1)
PY
}

cmd_verify() {
    local t="${1:-$(active)}" d; d=$(theme_dir "$t")
    say "verifying '$t'"
    render_templates
    verify_hypr "$d/hypr.lua" && note "hyprland layer ok"
    python3 -I -c 'import json,re,sys; s=open(sys.argv[1]).read(); s=re.sub(r"^\s*//.*$","",s,flags=re.M); s=re.sub(r",(\s*[}\]])",r"\1",s); json.loads(s)' \
        "$d/waybar/config.jsonc" && note "waybar config parses" || die "waybar config does not parse"
    verify_css 3.0 "$d/waybar/style.css" && note "waybar css ok (gtk3)"
    verify_css 4.0 "$d/swaync.css" && note "swaync css ok (gtk4)"
    if [[ -f "$d/walker/style.css" ]]; then verify_css 4.0 "$d/walker/style.css" && note "walker css ok (gtk4)"; fi
    if [[ -f "$d/shell/style.css" ]]; then verify_css 4.0 "$d/shell/style.css" && note "shell css ok (gtk4)"; fi
    if [[ -f "$d/session" ]]; then bash -n "$d/session" && note "session hook parses"; fi
    if [[ -d "$d/icons" ]] && have rsvg-convert; then
        local bad=0 f
        while IFS= read -r -d '' f; do
            rsvg-convert "$f" >/dev/null 2>&1 || { echo "bad svg: $f" >&2; bad=1; }
        done < <(find "$d/icons" -name '*.svg' -print0)
        (( bad )) && die "icon set has invalid svg" || note "icons render"
    fi
    python3 -I -m py_compile "$RF_SRC"/shell/*.py && note "shell python compiles"
    ensure_wallpaper "$t" && note "wallpaper present" || die "wallpaper missing"
}

# walker is a GApplication: a new service started before the old one has
# released its D-Bus name just forwards to it and exits, so wait first.
restart_walker() {
    pkill -x walker || true
    for _ in $(seq 20); do pgrep -x walker >/dev/null || break; sleep 0.1; done
    setsid -f walker --gapplication-service >/dev/null 2>&1
    sleep 0.5; pgrep -x walker >/dev/null
}

reload_all() {  # $1 = theme changed (1/0)
    (( LIVE )) || { note "not inside Hyprland: changes apply at next login"; return 0; }
    hyprctl reload >/dev/null && note "hyprland reloaded"
    pgrep -x waybar >/dev/null && pkill -SIGUSR2 -x waybar && note "waybar reloaded"
    pgrep -x swaync >/dev/null && swaync-client -rs >/dev/null 2>&1 && note "swaync restyled"
    pgrep -x kitty >/dev/null && pkill -SIGUSR1 -x kitty && note "kitty reloaded"
    if [[ "$1" == 1 || "${RICEFORGE_RESTART_WALKER:-0}" == 1 ]] && have walker; then
        # walker only scans themes at start; elephant must own a live socket first
        if have elephant && [[ ! -S "${XDG_RUNTIME_DIR:-/run/user/$UID}/elephant/elephant.sock" ]]; then
            pkill -x elephant || true; setsid -f elephant >/dev/null 2>&1; sleep 1
            note "elephant restarted (its socket was missing)"
        fi
        restart_walker && note "walker service restarted"
    fi
}

cmd_apply() {
    local t="${1:?usage: riceforge apply <theme>}" d prev
    d=$(theme_dir "$t")
    cmd_verify "$t"
    local old_theme; old_theme=$(active)
    prev=$(readlink "$CURRENT" 2>/dev/null || true)
    ln -sfn "themes/$t" "$CURRENT"
    if [[ -e "$CFG/hypr/hyprland.lua" ]] && ! verify_hypr "$CFG/hypr/hyprland.lua"; then
        [[ -n "$prev" ]] && ln -sfn "$prev" "$CURRENT"
        die "full hyprland config failed with '$t'; kept previous theme"
    fi
    note "full hyprland config ok"
    if (( LIVE )); then
        [[ "$old_theme" != none && "$old_theme" != "$t" ]] && run_session "$old_theme" stop
        reload_all "$([[ "$old_theme" != "$t" ]] && echo 1 || echo 0)"
        run_session "$t" start
    fi
    say "active: $t"
}

cmd_session_start() {
    local t; t=$(active)
    [[ "$t" == none ]] && { warn "no active theme (run ./setup)"; return 0; }
    ensure_wallpaper "$t" || true
    if has_session "$t"; then
        run_session "$t" start
    else
        . "$RF_SRC/bin/session-lib.sh"; applets_start; wallpaper_swaybg
    fi
}

cmd_status() {
    say "active theme: $(active)"
    local mode src dst
    while IFS=$'\t' read -r mode src dst; do
        [[ "$mode" == link ]] || continue
        if [[ -L "$HOME/$dst" ]]; then
            [[ -e "$HOME/$dst" ]] && note "ok      ~/$dst" || note "BROKEN  ~/$dst"
        elif [[ -e "$HOME/$dst" ]]; then note "plain   ~/$dst (not managed)"
        else note "missing ~/$dst"; fi
    done < <(manifest_rows deploy.tsv)
}

cmd_list() {
    local a; a=$(active)
    for d in "$THEMES"/*/; do
        local n; n=$(basename "$d")
        local desc; desc=$(. "$d/theme.env" 2>/dev/null; echo "${DESCRIPTION:-}")
        [[ "$n" == "$a" ]] && printf '%s* %-10s%s %s\n' "$c_acc" "$n" "$c_off" "$desc" \
                           || printf '  %-10s %s\n' "$n" "$desc"
    done
}

cmd_preview_bar() {
    local t="${1:?usage: riceforge preview-bar <theme>}" d tmp
    d=$(theme_dir "$t")
    # the stylesheet's icon urls are relative to ~/.config/waybar; mirror that layout
    tmp=$(mktemp -d); mkdir -p "$tmp/waybar" "$tmp/riceforge"
    ln -s "$d/waybar/style.css" "$tmp/waybar/style.css"; ln -s "$d" "$tmp/riceforge/current"
    say "showing $t's bar for ${2:-8}s alongside yours"
    timeout "${2:-8}" waybar -c "$d/waybar/config.jsonc" -s "$tmp/waybar/style.css" -l error >/dev/null 2>&1 || true
    rm -rf "$tmp"
}

cmd_update() {
    say "updating from git"
    local branch; branch=$(git -C "$RF_SRC" rev-parse --abbrev-ref HEAD)
    if [[ -n "$(git -C "$RF_SRC" status --porcelain --untracked-files=no)" ]]; then
        die "the checkout has local changes; commit or stash them first (git -C $RF_SRC status)"
    fi
    git -C "$RF_SRC" pull --ff-only || die "git pull failed (diverged? resolve manually)"
    note "now at $(git -C "$RF_SRC" log -1 --format='%h %s') on $branch"
    "$RF_SRC/setup" --no-packages --no-system --yes --keep-theme
    load_machine
    # shellcheck source=../install/dependencies.sh
    . "$RF_SRC/install/dependencies.sh"
    verify_dependencies || warn "new dependencies are missing: run $RF_SRC/setup to install them"
}

cmd_backups() {
    local d="$RF_STATE/backups"
    [[ -d "$d" ]] || { note "no backups yet"; return 0; }
    for b in "$d"/*/; do
        [[ -d "$b" ]] || continue
        printf '  %s  %s files\n' "$(basename "$b")" "$(find "$b" \( -type f -o -type l \) | wc -l)"
    done
}

cmd_restore() {
    local stamp="${1:?usage: riceforge restore <stamp> (see riceforge backups)}" b f rel
    b="$RF_STATE/backups/$stamp"; [[ -d "$b" ]] || die "no backup $stamp"
    say "restoring backup $stamp"
    while IFS= read -r -d '' f; do
        rel="${f#"$b"/}"
        if [[ -e "$HOME/$rel" || -L "$HOME/$rel" ]]; then
            if [[ -L "$HOME/$rel" && "$(readlink "$HOME/$rel")" == "$RF"/* ]]; then run rm -f -- "$HOME/$rel"
            else warn "~/$rel exists and is not a Riceforge link; left alone"; continue; fi
        fi
        run mkdir -p "$(dirname "$HOME/$rel")"
        run cp -a -- "$f" "$HOME/$rel"
        note "restored ~/$rel"
    done < <(find "$b" -mindepth 1 \( -type f -o -type l \) -print0)
    note "Riceforge links for restored paths were removed; ./setup puts them back"
}

case "${1:-status}" in
    list)        cmd_list ;;
    status)      cmd_status ;;
    verify)      cmd_verify "${2:-}" ;;
    apply)       cmd_apply "${2:-}" ;;
    revert)      cmd_apply original ;;
    preview-bar) cmd_preview_bar "${2:-}" "${3:-}" ;;
    session-start) cmd_session_start ;;
    render)      render_templates; ok "templates rendered" ;;
    doctor)      shift; exec "$RF_SRC/install/validation.sh" "$@" ;;
    update)      cmd_update ;;
    backups)     cmd_backups ;;
    restore)     cmd_restore "${2:-}" ;;
    uninstall|detach) shift; exec "$RF_SRC/install/uninstall.sh" "$@" ;;
    -h|--help|help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown command '$1' (riceforge help)" ;;
esac
