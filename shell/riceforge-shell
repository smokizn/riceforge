#!/usr/bin/env bash
# gtk4-layer-shell must be loaded before libwayland, which Python can't
# guarantee on its own; see https://github.com/wmww/gtk4-layer-shell/blob/main/linking.md
export LD_PRELOAD="/usr/lib/libgtk4-layer-shell.so${LD_PRELOAD:+:$LD_PRELOAD}"
# flat panels gain nothing from the GL renderer; cairo uses ~120 MB less memory
export GSK_RENDERER="${GSK_RENDERER:-cairo}"
exec python3 -I "$HOME/.config/riceforge/shell/main.py" "$@"
