// NACRE · floating glass islands
// left: orb + liquid workspace track · centre: the clock droplet · right: one control slab and satellites
{
    "layer": "top",
    "position": "top",
    "height": 46,
    "margin-top": 4,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 0,

    "modules-left": [
        "group/nav",
        "wlr/taskbar",
        "custom/bullet",
        "custom/hb"
    ],
    "modules-center": [
        "custom/spotify",
        "clock"
    ],
    "modules-right": [
        "group/system",
        "group/controls",
        "tray",
        "custom/power-menu"
    ],

    // ── left ──────────────────────────────────────────────
    "group/nav": {
        "orientation": "horizontal",
        "modules": ["custom/orb", "hyprland/workspaces"]
    },

    "custom/orb": {
        "format": "",
        "tooltip-format": "Walker",
        "on-click": "walker",
        "on-click-right": "walker -m providerlist"
    },

    // dots; the active one stretches into a liquid lozenge (see style.css)
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": { "default": "" },
        "all-outputs": true,
        "sort-by-number": true,
        "persistent-workspaces": { "*": 5 }
    },

    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 16,
        "tooltip-format": "{title}",
        "spacing": 0,
        "on-click": "activate",
        "on-click-middle": "close",
        "ignore-list": ["Alacritty", "kitty"],
        "app_ids-mapping": {
            "firefoxdeveloperedition": "firefox-developer-edition"
        }
    },

    "custom/bullet": {
        "format": "{}",
        "return-type": "json",
        "exec": "cat /tmp/waybar_bullet_state.json 2>/dev/null || echo '{\"text\": \" \", \"class\": \"hidden\"}'",
        "exec-on-event": false,
        "signal": 9
    },

    "custom/hb": {
        "format": "🍑",
        "return-type": "json",
        "exec": "cat /tmp/waybar_gun_state.json || echo '{\"text\": \"\", \"class\": \"idle\"}'",
        "exec-on-event": false,
        "on-click": "~/.config/waybar/scripts/gun.sh",
        "signal": 8
    },

    // ── centre ────────────────────────────────────────────
    "clock": {
        "interval": 30,
        "format": "<span weight='600'>{0:%H:%M}</span><span size='78%' alpha='55%'>   {0:%a %d}</span>",
        "format-alt": "<span weight='600'>{0:%A}</span><span size='78%' alpha='55%'>   {0:%d %B %Y}</span>",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "",
            "format": {
                "months":   "<span color='#eeecf8'><b>{}</b></span>",
                "weekdays": "<span color='#8b8fa6'>{}</span>",
                "days":     "<span color='#c4c7d6'>{}</span>",
                "today":    "<span color='#b7a8ff'><b>{}</b></span>"
            }
        }
    },

    // only visible while spotify has something to say
    "custom/spotify": {
        "exec": "python3 ~/.config/waybar/scripts/mediaplayer.py --player spotify",
        "format": "󰎈  {}",
        "max-length": 38,
        "return-type": "json",
        "on-click": "playerctl --player=spotify play-pause",
        "on-double-click-right": "playerctl --player=spotify next",
        "on-scroll-up": "playerctl --player=spotify next",
        "on-scroll-down": "playerctl --player=spotify previous"
    },

    // ── right ─────────────────────────────────────────────
    // cpu is the satellite's face; hover pours out memory and the fan
    "group/system": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 320,
            "children-class": "system-item",
            "transition-left-to-right": false
        },
        "modules": ["cpu", "memory", "custom/fan_monitor", "custom/fan"]
    },

    "cpu": {
        "interval": 5,
        "format": "󰻠  {usage}%"
    },

    "memory": {
        "interval": 10,
        "format": "󰍛  {percentage}%",
        "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
    },

    "custom/fan_monitor": {
        "exec": "~/.config/hypr/hyprland/scripts/fan_monitor.sh",
        "return-type": "json",
        "interval": 3,
        "tooltip": true
    },

    "custom/fan": {
        "format": "󰈐",
        "on-click": "python3 ~/.config/hypr/hyprland/scripts/fan_toggle.py",
        "tooltip-format": "Toggle fan: auto / max"
    },

    "group/controls": {
        "orientation": "horizontal",
        "modules": ["pulseaudio", "custom/mic-toggle", "backlight", "bluetooth", "battery"]
    },

    "pulseaudio": {
        "format": "{icon}  {volume}",
        "format-bluetooth": "󰂰  {volume}",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋋",
            "headset": "󰋋",
            "phone": "󰏲",
            "portable": "󰏲",
            "car": "󰄋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "tooltip-format": "{desc} · {volume}%",
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "smooth-scrolling-threshold": 1,
        "max-volume": 150
    },

    "custom/mic-toggle": {
        "format": "{}",
        "exec": "bash ~/.config/waybar/scripts/mic_toggle.sh",
        "return-type": "json",
        "on-click": "bash ~/.config/waybar/scripts/mic_toggle_click.sh",
        "signal": 12
    },

    "backlight": {
        "format": "{icon}",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "tooltip-format": "Brightness {percent}%",
        "on-scroll-up": "brightnessctl set 1%+",
        "on-scroll-down": "brightnessctl set 1%-"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-connected": "󰂱",
        "tooltip-format": "{controller_alias} · {status}",
        "tooltip-format-connected": "{device_alias}",
        "on-click": "bash ~/.config/waybar/scripts/rofi-bluetooth &",
        "on-click-right": "blueman-manager"
    },

    "battery": {
        "interval": 30,
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon}  {capacity}",
        "format-charging": "󰂄  {capacity}",
        "format-plugged": "󰚥  {capacity}",
        "format-full": "󰁹",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
        "tooltip-format": "{capacity}% · {timeTo}"
    },

    "tray": {
        "icon-size": 15,
        "spacing": 10
    },

    "custom/power-menu": {
        "format": "󰐥",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "~/.config/riceforge/current/waybar/power_menu.xml",
        "menu-actions": {
            "lock": "pidof hyprlock || hyprlock",
            "suspend": "systemctl suspend",
            "reload": "hyprctl reload",
            "reboot": "systemctl reboot",
            "shutdown": "systemctl poweroff"
        }
    }
}
