// NACRE · Visionary · the bar as an astronomer's rule
// left: sigil + constellation of workspaces · centre: the engraved clock plaque
// right: instruments · connections (real panels) · senses · vial · tray · power
{
    "layer": "top",
    "position": "top",
    "height": 50,
    "margin-top": 2,
    "margin-left": 4,
    "margin-right": 4,
    "spacing": 0,

    "modules-left": [
        "group/nav",
        "wlr/taskbar",
        "custom/bullet",
        "custom/hb"
    ],
    "modules-center": [
        "group/plaque",
        "custom/spotify"
    ],
    "modules-right": [
        "group/system",
        "group/connections",
        "group/senses",
        "battery",
        "tray",
        "custom/power-menu"
    ],

    // ── left ──────────────────────────────────────────────
    "group/nav": {
        "orientation": "horizontal",
        "modules": ["custom/sigil", "hyprland/workspaces"]
    },

    "custom/sigil": {
        "format": " ",
        "tooltip-format": "Walker (right-click: providers)",
        "on-click": "walker",
        "on-click-right": "walker -m providerlist"
    },

    // stars on a hairline; the icon comes from CSS by state
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": { "default": " " },
        "all-outputs": true,
        "sort-by-number": true,
        "persistent-workspaces": { "*": 5 }
    },

    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 16,
        "tooltip-format": "{title}",
        "spacing": 0,
        "on-click": "activate",
        "on-click-middle": "close",
        "ignore-list": ["Alacritty", "kitty"],
        "app_ids-mapping": {
            "firefoxdeveloperedition": "firefox-developer-edition"
        }
    },

    "custom/bullet": {
        "format": "{}",
        "return-type": "json",
        "exec": "cat /tmp/waybar_bullet_state.json 2>/dev/null || echo '{\"text\": \" \", \"class\": \"hidden\"}'",
        "exec-on-event": false,
        "signal": 9
    },

    "custom/hb": {
        "format": "🍑",
        "return-type": "json",
        "exec": "cat /tmp/waybar_gun_state.json || echo '{\"text\": \"\", \"class\": \"idle\"}'",
        "exec-on-event": false,
        "on-click": "~/.config/waybar/scripts/gun.sh",
        "signal": 8
    },

    // ── centre: the plaque ────────────────────────────────
    "group/plaque": {
        "orientation": "horizontal",
        "modules": ["custom/moon", "clock"]
    },

    // the moon's real phase (computed locally, once an hour); click: the ephemeris
    "custom/moon": {
        "exec": "python3 -I ~/.config/riceforge/shell/moonphase.py",
        "return-type": "json",
        "interval": 3600,
        "format": "{}",
        "on-click": "~/.config/riceforge/shell/riceforge-shell moon"
    },

    "clock": {
        "interval": 30,
        "format": "<span weight='600'>{0:%H:%M}</span><span size='72%' alpha='60%'>   {0:%a · %d %b}</span>",
        "format-alt": "<span weight='600'>{0:%A}</span><span size='72%' alpha='60%'>   {0:%d %B %Y}</span>",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "",
            "format": {
                "months":   "<span color='#e6dfcf'><b>{}</b></span>",
                "weekdays": "<span color='#6e6a64'>{}</span>",
                "days":     "<span color='#d6cbb2'>{}</span>",
                "today":    "<span color='#b39a5e'><b><u>{}</u></b></span>"
            }
        }
    },

    "custom/spotify": {
        "exec": "python3 ~/.config/waybar/scripts/mediaplayer.py --player spotify",
        "format": "{}",
        "max-length": 38,
        "return-type": "json",
        "on-click": "playerctl --player=spotify play-pause",
        "on-double-click-right": "playerctl --player=spotify next",
        "on-scroll-up": "playerctl --player=spotify next",
        "on-scroll-down": "playerctl --player=spotify previous"
    },

    // ── right ─────────────────────────────────────────────
    "group/system": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 320,
            "children-class": "system-item",
            "transition-left-to-right": false
        },
        "modules": ["cpu", "memory", "custom/fan_monitor", "custom/fan"]
    },

    "cpu": {
        "interval": 5,
        "format": "{usage}%",
        "tooltip-format": "CPU {usage}% · hover to open the instruments"
    },

    "memory": {
        "interval": 10,
        "format": "{percentage}%",
        "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
    },

    "custom/fan_monitor": {
        "exec": "~/.config/hypr/hyprland/scripts/fan_monitor.sh",
        "return-type": "json",
        "interval": 3,
        "tooltip": true
    },

    "custom/fan": {
        "format": " ",
        "on-click": "python3 ~/.config/hypr/hyprland/scripts/fan_toggle.py",
        "tooltip-format": "Toggle fan: auto / max"
    },

    "group/connections": {
        "orientation": "horizontal",
        "modules": ["network", "bluetooth"]
    },

    // NetworkManager-backed and event driven; click opens the real Wi-Fi panel
    "network": {
        "interval": 60,
        "format-wifi": "{essid}",
        "format-ethernet": "wired",
        "format-linked": "no address",
        "format-disconnected": "offline",
        "format-disabled": "radio off",
        "max-length": 18,
        "tooltip-format-wifi": "{essid} · {signalStrength}% · {frequency} GHz\n{ipaddr} on {ifname}",
        "tooltip-format-ethernet": "{ifname} · {ipaddr}",
        "tooltip-format-disconnected": "Not connected · click to choose a network",
        "on-click": "~/.config/riceforge/shell/riceforge-shell wifi",
        "on-click-right": "nm-connection-editor"
    },

    "bluetooth": {
        "format": "on",
        "format-off": "off",
        "format-disabled": "off",
        "format-connected": "{device_alias}",
        "format-connected-battery": "{device_alias} {device_battery_percentage}%",
        "max-length": 16,
        "tooltip-format": "{controller_alias} · {status}",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias} · {device_battery_percentage}%",
        "on-click": "~/.config/riceforge/shell/riceforge-shell bluetooth"
    },

    "group/senses": {
        "orientation": "horizontal",
        "modules": ["pulseaudio", "custom/mic-toggle", "backlight"]
    },

    "pulseaudio": {
        "format": "{volume}",
        "format-bluetooth": "{volume}",
        "format-muted": "muted",
        "tooltip-format": "{desc} · {volume}%",
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "smooth-scrolling-threshold": 1,
        "max-volume": 150
    },

    "custom/mic-toggle": {
        "format": "{}",
        "exec": "bash ~/.config/waybar/scripts/mic_toggle.sh",
        "return-type": "json",
        "on-click": "bash ~/.config/waybar/scripts/mic_toggle_click.sh",
        "signal": 12
    },

    "backlight": {
        "format": "{percent}",
        "tooltip-format": "Brightness {percent}%",
        "on-scroll-up": "brightnessctl set 1%+",
        "on-scroll-down": "brightnessctl set 1%-"
    },

    // the vial: liquid level from the state classes below
    "battery": {
        "interval": 30,
        "states": { "full": 100, "high": 75, "mid": 50, "low": 30, "warning": 20, "critical": 10 },
        "format": "{capacity}",
        "format-charging": "{capacity}",
        "format-plugged": "{capacity}",
        "tooltip-format": "{capacity}% · {timeTo}"
    },

    "tray": {
        "icon-size": 15,
        "spacing": 10
    },

    "custom/power-menu": {
        "format": " ",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "~/.config/riceforge/current/waybar/power_menu.xml",
        "menu-actions": {
            "lock": "pidof hyprlock || hyprlock",
            "suspend": "systemctl suspend",
            "reload": "hyprctl reload",
            "reboot": "systemctl reboot",
            "shutdown": "systemctl poweroff"
        }
    }
}
