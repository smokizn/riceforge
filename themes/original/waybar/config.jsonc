{
    "layer": "top",
    "position": "top",
    "height": 32,
    "margin-top": 0,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 4,

    "modules-left": [
        "custom/launcher",
        "clock",
        "cpu",
        "memory",
        "group/system",
        "custom/spotify",
        "custom/bullet",
        "custom/hb"
        
        
    ],
    "modules-center": [
        "hyprland/workspaces",
        "wlr/taskbar"
    ],
    "modules-right": [
        "bluetooth",
        "pulseaudio",
        "backlight",
        "battery",
        "custom/mic-toggle",
        "tray",
        "custom/power-menu"
    ],

    "group/system": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 280,
            "children-class": "system-item",
            "transition-left-to-right": true
        },
        "modules": [
            "custom/fan",
            "custom/fan_monitor"
        ]
    },
    
    "custom/fan": {
    "format": "󰈐",
    "on-click": "python3 ~/.config/hypr/hyprland/scripts/fan_toggle.py",
    "tooltip-format": "Left click to toggle Auto/Max fan speed"
},

  "custom/hb": {
    "format": "🍑",
    "return-type": "json",
    "exec": "cat /tmp/waybar_gun_state.json || echo '{\"text\": \"\", \"class\": \"idle\"}'",
    "exec-on-event": false,
    "on-click": "~/.config/waybar/scripts/gun.sh",
    "signal": 8
  },
  

  "custom/bullet": {
    "format": "{}",
    "return-type": "json",
    "exec": "cat /tmp/waybar_bullet_state.json 2>/dev/null || echo '{\"text\": \" \", \"class\": \"hidden\"}'",
    "exec-on-event": false,
    "signal": 9
  },


     "custom/fan_monitor": {
    "exec": "~/.config/hypr/hyprland/scripts/fan_monitor.sh",
    "return-type": "json",
    "interval": 1,
    "tooltip": true
},

 "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "hl.dispatch(workspace {id})",
        "all-outputs": true,
        "sort-by-number": true,
        "format-icons": {
            "1": "一",
            "2": "二",
            "3": "三",
            "4": "四",
            "5": "五",
            "6": "六",
            "7": "七",
            "8": "八",
            "9": "九",
            "10": "十",
            "urgent": "",
            "active": "●",
            "default": "○"
        },
        "persistent-workspaces": {
            "*": 10
        }
    },
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 14,
        "tooltip-format": "{title}",
        "spacing": 2,
        "on-click": "activate",
        "on-click-middle": "close",
        "ignore-list": [
            "Alacritty",
            "kitty"
        ],
        "app_ids-mapping": {
            "firefoxdeveloperedition": "firefox-developer-edition"
        }
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%A, %B %d}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },

    "cpu": {
        "interval": 2,
        "format": " {usage}%"
    },

    "memory": {
        "interval": 2,
        "format": " {}%"
    },

    "backlight": {
        "device": "DP-1",
        "format": "{icon} {percent}%",
        "format-icons": ["", "", "", "", "", "", "", "", ""],
        "on-scroll-up": "brightnessctl set 1%+",
        "on-scroll-down": "brightnessctl set 1%-"
    },

    "network": {
        "format-wifi": "",
        "format-ethernet": "  Wired",
        "format-disconnected": "  Offline",
        "on-click": "bash ~/.config/waybar/scripts/rofi-wifi-menu.sh",
        "on-click-right": "nm-connection-editor" 
    },

    "bluetooth": {
        "format": "",
        "format-connected": "",
        "tooltip-format": "{device_alias}",
        "on-click": "bash ~/.config/waybar/scripts/rofi-bluetooth &",
        "on-click-right": "blueman-manager"
    },

"pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "󰂰 {icon} {volume}%",
    "format-muted": "󰝟 Muted",
    "format-icons": {
        "headphone": "󰋋",
        "hands-free": "󰋋",
        "headset": "󰋋",
        "phone": "󰏲",
        "portable": "󰏲",
        "car": "󰄋",
        "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "smooth-scrolling-threshold": 1,
    "max-volume": 150 
},

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },

    "custom/spotify": {
        "exec": "python3 ~/.config/waybar/scripts/mediaplayer.py --player spotify",
        "format": " {}",
        "return-type": "json",
        "on-click": "playerctl --player=spotify play-pause",
        "on-double-click-right": "playerctl --player=spotify next",
        "on-scroll-up": "playerctl --player=spotify next",
        "on-scroll-down": "playerctl --player=spotify previous"
    },

    "custom/power-menu": {
        "format": "",
        "on-click": "wlogout -b 3"
    }, 

    "custom/launcher": {
        "format": ""
         },

    "custom/mic-toggle": {
        "format": "{}",
        "exec": "bash ~/.config/waybar/scripts/mic_toggle.sh",
        "return-type": "json",
        "on-click": "bash ~/.config/waybar/scripts/mic_toggle_click.sh",
        "signal": 12
    }
}
