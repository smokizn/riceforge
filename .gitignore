themes/nacre/wallpapers/thumbs/fenestra.jpg
themes/nacre/wallpapers/thumbs/draco.jpg
themes/nacre/wallpapers/thumbs/trigonum.jpg

# old in-repo backups (new backups live in ~/.local/state/riceforge/backups)
backups/

# caches
__pycache__/
*.pyc
tests/.sandbox/
